generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  password            String?
  name                String
  role                String          @default("user")
  oauthProvider       String?         @map("oauth_provider")
  oauthId             String?         @map("oauth_id")
  oauthAccessToken    String?         @map("oauth_access_token") @db.Text
  oauthRefreshToken   String?         @map("oauth_refresh_token") @db.Text
  oauthTokenExpiresAt DateTime?       @map("oauth_token_expires_at")
  profilePicture      String?         @map("profile_picture") @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")
  tasks               Task[]          @relation("AssignedUser")
  crAssigned          ChangeRequest[] @relation("CrAssignee")
  crReported          ChangeRequest[] @relation("CrReporter")
  crApproved          ChangeRequest[] @relation("CrApprover")
  crEvents            ChangeEvent[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

model Project {
  id                 String          @id @default(uuid())
  name               String
  code               String          @unique
  description        String?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  tasks              Task[]
  changeRequests     ChangeRequest[]
  // Start-time alerts: email owners when their task is ready. New projects start Off.
  startAlertsEnabled Boolean         @default(false) @map("start_alerts_enabled")
  // IANA zone the cutover runs in. Emails, the acknowledge page and the Timeline show
  // times in this zone with UTC alongside.
  timeZone           String          @default("America/Chicago") @map("time_zone")

  @@map("projects")
}

model Task {
  id               String    @id @default(uuid())
  system           String
  taskName         String    @map("task_name")
  description      String?
  assignedTeam     String?   @map("assigned_team")
  assignedUserId   String?   @map("assigned_user_id")
  assignedUser     User?     @relation("AssignedUser", fields: [assignedUserId], references: [id])
  plannedStartTime DateTime? @map("planned_start_time")
  plannedEndTime   DateTime? @map("planned_end_time")
  actualStartTime  DateTime? @map("actual_start_time")
  actualEndTime    DateTime? @map("actual_end_time")
  status           String    @default("Pending")
  notes            String?
  projectId        String    @map("project_id")
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequenceNumber   Int       @map("sequence_number")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  dependsOn  TaskDependency[] @relation("TaskDependsOn")
  dependedBy TaskDependency[] @relation("TaskDependedBy")
  auditLogs  AuditLog[]
  alert      TaskAlert?

  @@unique([projectId, sequenceNumber])
  @@index([projectId])
  @@index([status, plannedStartTime])
  @@index([status])
  @@index([assignedUserId])
  @@map("tasks")
}

model TaskDependency {
  id              String @id @default(uuid())
  taskId          String @map("task_id")
  dependsOnTaskId String @map("depends_on_task_id")

  task      Task @relation("TaskDependsOn", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("TaskDependedBy", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@index([taskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

model AuditLog {
  id        String   @id @default(uuid())
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  action    String
  field     String?
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  userId    String?  @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId])
  @@map("audit_logs")
}

// ── Change Request module ───────────────────────────────────────────────────
// A change request (CR / CAB request) tracks one change from idea to production.
// Its optional cutover plan is an ordinary Tilli-go Project, so the existing
// task grid, scheduler and email worker run the go-live unchanged.
model ChangeRequest {
  id            String             @id @default(uuid())
  number        Int                @unique @default(autoincrement())
  title         String
  description   String             @db.Text
  product       String
  changeType    String             @map("change_type")
  releaseType   String             @map("release_type")
  priority      String
  impact        String
  risk          String
  customer      String?
  labels        String[]           @default([])
  plannedGoLive DateTime           @map("planned_go_live")
  dueDate       DateTime?          @map("due_date")
  needsCutover  Boolean            @default(true) @map("needs_cutover")
  status        String             @default("NEW")
  assigneeId    String             @map("assignee_id")
  assignee      User               @relation("CrAssignee", fields: [assigneeId], references: [id])
  reporterId    String             @map("reporter_id")
  reporter      User               @relation("CrReporter", fields: [reporterId], references: [id])
  approvedById  String?            @map("approved_by_id")
  approvedBy    User?              @relation("CrApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?          @map("approved_at")
  projectId     String?            @map("project_id")
  project       Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  events        ChangeEvent[]
  attachments   ChangeAttachment[]

  @@index([status])
  @@index([product, plannedGoLive])
  @@map("change_requests")
}

model ChangeEvent {
  id              String        @id @default(uuid())
  changeRequestId String        @map("change_request_id")
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  kind            String // CREATED | STATUS | COMMENT | ATTACHMENT | CUTOVER
  fromStatus      String?       @map("from_status")
  toStatus        String?       @map("to_status")
  message         String?       @db.Text
  actorId         String        @map("actor_id")
  actor           User          @relation(fields: [actorId], references: [id])
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([changeRequestId, createdAt])
  @@map("change_events")
}

// Files are stored outside the database (disk now, SharePoint later); only metadata lives here.
model ChangeAttachment {
  id              String        @id @default(uuid())
  changeRequestId String        @map("change_request_id")
  changeRequest   ChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  fileName        String        @map("file_name")
  mimeType        String        @map("mime_type")
  size            Int
  provider        String // local | sharepoint
  storageKey      String        @map("storage_key")
  uploadedById    String        @map("uploaded_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  @@index([changeRequestId])
  @@map("change_attachments")
}

// ── Start-time alerts ───────────────────────────────────────────────────────
// One row per task: who was told, when, and whether they started.
// status: SENT | ACKNOWLEDGED | NO_OWNER | FAILED | RETRYING | BLOCKED_DOMAIN
model TaskAlert {
  id             String    @id @default(uuid())
  taskId         String    @unique @map("task_id")
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status         String
  recipient      String?
  sentAt         DateTime? @map("sent_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  messageId      String?   @map("message_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@map("task_alerts")
}
