{
  "name": "tilli-go-worker",
  "version": "1.0.0",
  "description": "Tilli-go BullMQ worker service",
  "main": "dist/index.js",
  "scripts": {
    "predev": "node scripts/prisma-generate.mjs",
    "dev": "tsx watch index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pretypecheck": "node scripts/prisma-generate.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "node scripts/prisma-generate.mjs",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "axios": "^1.16.1",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "nodemailer": "^6.9.15",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
